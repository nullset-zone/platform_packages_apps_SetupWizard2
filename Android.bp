android_app {
    name: "SetupWizard2",
    // T-WIZ-GESTURES-REMOVE: exclude the Gestures wizard step source files.
    // The GesturesActivity activity entry is also removed from
    // AndroidManifest.xml so the wizard no longer offers a gestures page.
    // T-SUW-RM-WIFI: exclude the Wifi wizard step source files for both
    // primary and secondary user paths. The WifiActivity manifest entry is
    // also removed. Source files are retained (Law 11 reversibility) so the
    // step can be restored by removing these excludes.
    srcs: ["java/**/*.kt"],
    exclude_srcs: [
        "java/app/grapheneos/setupwizard/view/activity/GesturesActivity.kt",
        "java/app/grapheneos/setupwizard/action/GesturesActions.kt",
        "java/app/grapheneos/setupwizard/view/activity/WifiActivity.kt",
        "java/app/grapheneos/setupwizard/action/WifiActions.kt",
    ],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",

    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    platform_apis: true,

    overrides: ["Provision"],

    static_libs: [
        "androidx.core_core",
        "setupcompat",
        "setupdesign",
    ],

    required: ["etc_permissions_app.grapheneos.setupwizard"],
}

prebuilt_etc {
    name: "etc_permissions_app.grapheneos.setupwizard",
    src: "etc/permissions/app.grapheneos.setupwizard.xml",
    sub_dir: "permissions",
    filename_from_src: true,
    system_ext_specific: true,
}
